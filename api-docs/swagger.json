{
  "openapi": "3.0.0",
  "info": {
    "title": "ReelFlow API",
    "version": "1.0.0",
    "description": "ReelFlow platformasi uchun RESTful API",
    "contact": {
      "name": "ReelFlow Support",
      "email": "support@reelflow.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local development server"
    },
    {
      "url": "https://api.reelflow.com/api",
      "description": "Production server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Authentication endpoints" },
    { "name": "Users", "description": "User management endpoints" },
    { "name": "Videos", "description": "Video operations endpoints" },
    { "name": "Comments", "description": "Comment system endpoints" },
    { "name": "Messages", "description": "Direct messages endpoints" },
    { "name": "Payments", "description": "Payment processing endpoints" },
    { "name": "Admin", "description": "Admin panel endpoints" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "65f1a2b3c4d5e6f7g8h9i0j1" },
          "username": { "type": "string", "example": "dilnoza_07" },
          "email": { "type": "string", "example": "dilnoza@mail.com" },
          "fullName": { "type": "string", "example": "Dilnoza" },
          "bio": { "type": "string", "example": "Videolar yaratishni sevaman 🎬" },
          "avatar": { "type": "string", "example": "https://reelflow.com/avatars/avatar.jpg" },
          "website": { "type": "string", "example": "https://dilnoza.uz" },
          "followers": { "type": "array", "items": { "type": "string" } },
          "following": { "type": "array", "items": { "type": "string" } },
          "savedVideos": { "type": "array", "items": { "type": "string" } },
          "isVerified": { "type": "boolean", "example": false },
          "isPrivate": { "type": "boolean", "example": false },
          "stats": {
            "type": "object",
            "properties": {
              "videoCount": { "type": "number", "example": 24 },
              "followerCount": { "type": "number", "example": 1240 },
              "followingCount": { "type": "number", "example": 342 },
              "totalLikes": { "type": "number", "example": 5000 }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Video": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string", "example": "Samarqand sayohati" },
          "description": { "type": "string", "example": "Bugun Samarqandda ajoyib kun!" },
          "videoUrl": { "type": "string", "example": "https://reelflow.com/videos/video123.mp4" },
          "thumbnailUrl": { "type": "string", "example": "https://reelflow.com/thumbnails/thumb123.jpg" },
          "user": { "$ref": "#/components/schemas/User" },
          "views": { "type": "number", "example": 12450 },
          "likes": { "type": "array", "items": { "type": "string" } },
          "likesCount": { "type": "number", "example": 342 },
          "commentsCount": { "type": "number", "example": 56 },
          "shares": { "type": "number", "example": 23 },
          "saves": { "type": "number", "example": 89 },
          "duration": { "type": "number", "example": 45 },
          "hashtags": { "type": "array", "items": { "type": "string" }, "example": ["samarqand", "sayohat"] },
          "location": { "type": "string", "example": "Samarqand, O'zbekiston" },
          "isPrivate": { "type": "boolean", "example": false },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "text": { "type": "string", "example": "Juda zo'r video!" },
          "user": { "$ref": "#/components/schemas/User" },
          "video": { "type": "string" },
          "likes": { "type": "array", "items": { "type": "string" } },
          "likesCount": { "type": "number", "example": 12 },
          "replies": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } },
          "replyCount": { "type": "number", "example": 3 },
          "isPinned": { "type": "boolean", "example": false },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "sender": { "$ref": "#/components/schemas/User" },
          "receiver": { "$ref": "#/components/schemas/User" },
          "text": { "type": "string", "example": "Salom! Qalaysan?" },
          "image": { "type": "string" },
          "video": { "type": "string" },
          "voice": { "type": "string" },
          "isRead": { "type": "boolean", "example": false },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" },
          "type": { "type": "string", "enum": ["deposit", "withdraw", "gift", "ad_revenue"] },
          "amount": { "type": "number", "example": 100 },
          "currency": { "type": "string", "example": "USD" },
          "method": { "type": "string", "enum": ["credit_card", "paypal", "crypto"] },
          "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "error": { "type": "string" },
          "statusCode": { "type": "number" }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Yangi foydalanuvchi ro'yxatdan o'tish",
        "description": "Yangi akkaunt yaratish",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": { "type": "string", "minLength": 3, "maxLength": 30, "example": "dilnoza_07" },
                  "email": { "type": "string", "format": "email", "example": "dilnoza@mail.com" },
                  "password": { "type": "string", "minLength": 6, "example": "password123" },
                  "fullName": { "type": "string", "example": "Dilnoza" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Foydalanuvchi muvaffaqiyatli yaratildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "username": { "type": "string" },
                    "email": { "type": "string" },
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Xato ma'lumotlar yoki foydalanuvchi mavjud" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Tizimga kirish",
        "description": "Email va parol orqali tizimga kirish",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "dilnoza@mail.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kirish muvaffaqiyatli",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_id": { "type": "string" },
                    "username": { "type": "string" },
                    "email": { "type": "string" },
                    "avatar": { "type": "string" },
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Email yoki parol noto'g'ri" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Joriy foydalanuvchi ma'lumotlari",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Foydalanuvchi ma'lumotlari", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "401": { "description": "Token noto'g'ri yoki yo'q" }
        }
      }
    },
    "/videos": {
      "get": {
        "tags": ["Videos"],
        "summary": "Barcha videolar ro'yxati",
        "description": "Asosiy tasma uchun videolar",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Sahifa raqami" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Har bir sahifadagi videolar soni" },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["foryou", "following"] }, "description": "Tasma turi" }
        ],
        "responses": {
          "200": {
            "description": "Videolar ro'yxati",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "videos": { "type": "array", "items": { "$ref": "#/components/schemas/Video" } },
                    "totalPages": { "type": "number" },
                    "currentPage": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/videos/upload": {
      "post": {
        "tags": ["Videos"],
        "summary": "Video yuklash",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "maxLength": 100 },
                  "description": { "type": "string", "maxLength": 500 },
                  "video": { "type": "string", "format": "binary" },
                  "thumbnail": { "type": "string", "format": "binary" },
                  "hashtags": { "type": "string", "description": "Vergul bilan ajratilgan hashtaglar" },
                  "isPrivate": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Video muvaffaqiyatli yuklandi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Video" } } } },
          "400": { "description": "Xato ma'lumotlar yoki fayl topilmadi" },
          "413": { "description": "Fayl hajmi juda katta" }
        }
      }
    },
    "/videos/{id}": {
      "get": {
        "tags": ["Videos"],
        "summary": "Video ma'lumotlarini olish",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Video topildi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Video" } } } },
          "404": { "description": "Video topilmadi" }
        }
      },
      "delete": {
        "tags": ["Videos"],
        "summary": "Videoni o'chirish",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Video o'chirildi" },
          "403": { "description": "O'chirish huquqi yo'q" },
          "404": { "description": "Video topilmadi" }
        }
      }
    },
    "/videos/{id}/like": {
      "post": {
        "tags": ["Videos"],
        "summary": "Videoga layk bosish yoki olish",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Layk bosildi/olindi", "content": { "application/json": { "schema": { "type": "object", "properties": { "liked": { "type": "boolean" }, "likesCount": { "type": "number" } } } } } }
        }
      }
    },
    "/videos/{id}/view": {
      "post": {
        "tags": ["Videos"],
        "summary": "Ko'rishlar sonini oshirish",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Ko'rishlar soni yangilandi" }
        }
      }
    },
    "/users/{username}": {
      "get": {
        "tags": ["Users"],
        "summary": "Foydalanuvchi profilini olish",
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Foydalanuvchi topildi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "404": { "description": "Foydalanuvchi topilmadi" }
        }
      }
    },
    "/users/profile": {
      "put": {
        "tags": ["Users"],
        "summary": "Profil ma'lumotlarini yangilash",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": { "type": "string" },
                  "bio": { "type": "string", "maxLength": 150 },
                  "website": { "type": "string" },
                  "avatar": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profil yangilandi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } }
        }
      }
    },
    "/users/follow/{userId}": {
      "post": {
        "tags": ["Users"],
        "summary": "Foydalanuvchini kuzatish yoki kuzatishdan to'xtash",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Kuzatish holati o'zgartirildi", "content": { "application/json": { "schema": { "type": "object", "properties": { "following": { "type": "boolean" }, "followersCount": { "type": "number" } } } } } },
          "400": { "description": "O'zini kuzata olmaydi" }
        }
      }
    },
    "/users/search": {
      "get": {
        "tags": ["Users"],
        "summary": "Foydalanuvchilarni qidirish",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Qidiruv so'zi" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Qidiruv natijalari", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } } } } }
        }
      }
    },
    "/comments/{videoId}": {
      "get": {
        "tags": ["Comments"],
        "summary": "Video izohlarini olish",
        "parameters": [
          { "name": "videoId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": { "description": "Izohlar ro'yxati", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } } } } }
        }
      },
      "post": {
        "tags": ["Comments"],
        "summary": "Yangi izoh qo'shish",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "videoId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "maxLength": 300 },
                  "parentCommentId": { "type": "string", "description": "Javob uchun parent izoh ID si" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Izoh qo'shildi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Comment" } } } }
        }
      }
    },
    "/comments/{commentId}/like": {
      "post": {
        "tags": ["Comments"],
        "summary": "Izohga layk bosish",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Layk bosildi/olindi", "content": { "application/json": { "schema": { "type": "object", "properties": { "liked": { "type": "boolean" }, "likesCount": { "type": "number" } } } } } }
        }
      }
    },
    "/comments/{commentId}": {
      "delete": {
        "tags": ["Comments"],
        "summary": "Izohni o'chirish",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Izoh o'chirildi" },
          "403": { "description": "O'chirish huquqi yo'q" }
        }
      }
    },
    "/messages": {
      "get": {
        "tags": ["Messages"],
        "summary": "Suhbatlar ro'yxatini olish",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Suhbatlar ro'yxati", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "user": { "$ref": "#/components/schemas/User" }, "lastMessage": { "$ref": "#/components/schemas/Message" }, "unreadCount": { "type": "number" } } } } } } }
        }
      }
    },
    "/messages/{userId}": {
      "get": {
        "tags": ["Messages"],
        "summary": "Foydalanuvchi bilan bo'lgan xabarlarni olish",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Xabarlar ro'yxati", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } } } } }
        }
      },
      "post": {
        "tags": ["Messages"],
        "summary": "Xabar yuborish",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" },
                  "image": { "type": "string" },
                  "video": { "type": "string" },
                  "voice": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Xabar yuborildi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } } }
        }
      }
    },
    "/payments/wallet": {
      "get": {
        "tags": ["Payments"],
        "summary": "Hamyon ma'lumotlarini olish",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Hamyon ma'lumotlari", "content": { "application/json": { "schema": { "type": "object", "properties": { "balance": { "type": "number" }, "totalEarned": { "type": "number" }, "totalWithdrawn": { "type": "number" } } } } } }
        }
      }
    },
    "/payments/deposit": {
      "post": {
        "tags": ["Payments"],
        "summary": "Hisobni to'ldirish",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "method"],
                "properties": {
                  "amount": { "type": "number", "minimum": 1 },
                  "method": { "type": "string", "enum": ["credit_card", "paypal", "crypto"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "To'lov intent yaratildi", "content": { "application/json": { "schema": { "type": "object", "properties": { "clientSecret": { "type": "string" }, "paymentIntentId": { "type": "string" } } } } } }
        }
      }
    },
    "/payments/withdraw": {
      "post": {
        "tags": ["Payments"],
        "summary": "Pul yechib olish",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "method"],
                "properties": {
                  "amount": { "type": "number", "minimum": 10 },
                  "method": { "type": "string", "enum": ["paypal", "bank_transfer"] },
                  "accountDetails": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pul yechish so'rovi yuborildi" },
          "400": { "description": "Hisobda yetarli mablag' yo'q" }
        }
      }
    },
    "/admin/users": {
      "get": {
        "tags": ["Admin"],
        "summary": "Barcha foydalanuvchilar ro'yxati (Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Foydalanuvchilar ro'yxati" },
          "403": { "description": "Admin huquqi talab qilinadi" }
        }
      }
    },
    "/admin/users/{userId}/block": {
      "post": {
        "tags": ["Admin"],
        "summary": "Foydalanuvchini bloklash (Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Foydalanuvchi bloklandi" }
        }
      }
    },
    "/admin/videos/{videoId}/block": {
      "post": {
        "tags": ["Admin"],
        "summary": "Videoni bloklash (Admin)",
        "security": [{ "bearerAuth": [] }],
